# Database
DATABASE_URL=postgresql://user:password@localhost:5432/transcription_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# AWS/S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=transcription-audio
S3_ENDPOINT_URL=  # Leave empty for AWS S3, or set to MinIO endpoint

# Whisper Model
WHISPER_MODEL=base  # base, small, medium, or large
DEVICE=cpu  # cpu or cuda

# Application
DEBUG=False
